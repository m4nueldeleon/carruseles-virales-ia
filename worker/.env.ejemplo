# .env.ejemplo: copia este archivo a .env (junto al docker-compose.yml) y llena los valores.
# .env nunca se sube al repo (está en .gitignore). Ninguna clave va en el código.

# --- Base de datos del Centro de Control de Marca (Supabase; la service key salta RLS a propósito) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Escritura del guion con la API de Anthropic. Sin la clave el worker arranca en modo espera ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Respaldo cuando la cuenta directa se queda sin saldo: cualquier gateway que sirva la misma API Messages.
# Con OpenRouter son estas tres líneas (la llave va en ANTHROPIC_API_KEY, el modelo lleva prefijo):
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1/messages
#   ANTHROPIC_MODEL=anthropic/claude-opus-5
# Vacía o sin definir, se habla directo con api.anthropic.com.
ANTHROPIC_BASE_URL=

# --- Transcripción de reels (Instagram, TikTok, Facebook) con Apify. Opcional: sin él siguen YouTube, artículos y PDF ---
APIFY_TOKEN=

# --- Almacén de imágenes: Vercel Blob (store público). Las láminas se guardan bajo ccm/carruseles/<pedido>/v<n>/ ---
BLOB_READ_WRITE_TOKEN=

# --- Banco de fotos en la nube: la URL base que `banco-fotos.py subir` escribió en MI-MARCA.md (banco_url) ---
BANCO_URL=

# --- Rutas dentro del contenedor (déjalas así salvo que cambies los volúmenes del docker-compose.yml) ---
SKILL_DIR=/skill
PRIVADO_DIR=/privado
TRABAJO_DIR=/trabajo
# Dónde vive el banco de fotos. Por omisión PRIVADO_DIR/assets/fotos/reales; si esa carpeta no es escribible
# (privado/ va montado de solo lectura) y no trae catálogo, el entrypoint lo baja a TRABAJO_DIR/_banco.
# BANCO_DIR=/privado/assets/fotos/reales

# --- Ritmo del worker ---
WORKER_INTERVALO_S=15
SKILL_PULL_MIN=30
# BANCO_REFRESCO_H=24
# WORKER_HUERFANO_MIN=90
# TRABAJO_RETENCION_DIAS=7
# WORKER_TIMEOUT_VERSION_MIN=25
# ESCRIBIR_RONDAS=2
# WORKER_APPS_CONOCIDAS=CapCut,Claude,ChatGPT,WhatsApp,Canva,Excel,Notion,Instagram,TikTok,YouTube,Gemini

# --- TOPES DE GASTO (la API de Anthropic se cobra por token; esto es el freno) ---
#
# Medido el 7-sep-2026 con llamadas reales: un pedido normal de 4 versiones cuesta alrededor de $1.41,
# y cada ronda de corrección de la puerta de calidad suma unos $0.22 por versión. Con eso:
#
# Tope por PEDIDO. Si un pedido lo pasa, la versión en curso se corta en seco y el pedido queda en
# «error» diciendo cuánto llevaba y cuál era el tope (las versiones que ya salieron se conservan).
# $3.00 deja pasar cualquier pedido normal, incluso con las dos rondas de corrección en las cuatro
# versiones (~$2.2), y corta un pedido desbocado a poco más del doble de lo normal. 0 = sin tope.
COSTO_TOPE_PEDIDO_USD=3

# Tope por DÍA (día local del contenedor, según TZ). Al alcanzarlo el worker DEJA DE TOMAR pedidos
# nuevos y lo dice en el log; los pendientes se quedan en la cola y se retoman mañana, no dan error.
# $20 son unos 14 pedidos normales en un día; el uso real ronda 1 al día, así que nunca estorba: lo
# que hace es que un día malo cueste $20 en vez de vaciar la tarjeta. 0 = sin tope.
# La cuenta del día se guarda en TRABAJO_DIR/_costos/gasto-AAAA-MM-DD.json y sobrevive a los reinicios.
COSTO_TOPE_DIA_USD=20

# A qué porcentaje del tope diario se avisa en el log (una vez al día). 80 = avisa en $16 de $20.
COSTO_AVISO_DIA_PCT=80

# Precios en dólares por millón de tokens, por si Anthropic los cambia o aparece un modelo que la
# tabla de worker/lib/costos.mjs todavía no conoce. Se mezcla ENCIMA de esa tabla; los cinco conceptos
# son obligatorios. Vacío = se usan los precios del código (confirmados el 7-sep-2026).
#   COSTO_PRECIOS_JSON={"claude-opus-6":{"entrada":5,"escritura5m":6.25,"escritura1h":10,"lectura":0.5,"salida":25}}
COSTO_PRECIOS_JSON=

# --- Atender solo los pedidos de una marca (opcional; vacío = todas) ---
WORKSPACE_ID=

# --- Opcionales ---
# TZ=America/Mexico_City          zona horaria de los logs
# SKILL_RAMA=main                 rama de la skill que clona la imagen (para probar antes de mezclar a main)
