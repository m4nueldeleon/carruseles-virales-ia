# .env.ejemplo: copia este archivo a .env (junto al docker-compose.yml) y llena los valores.
# .env nunca se sube al repo (está en .gitignore). Ninguna clave va en el código.

# --- Base de datos del Centro de Control de Marca (Supabase; la service key salta RLS a propósito) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Escritura del guion con la API de Anthropic. Sin la clave el worker arranca en modo espera ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Transcripción de reels (Instagram, TikTok, Facebook) con Apify. Opcional: sin él siguen YouTube, artículos y PDF ---
APIFY_TOKEN=

# --- Almacén de imágenes: Vercel Blob (store público). Las láminas se guardan bajo ccm/carruseles/<pedido>/v<n>/ ---
BLOB_READ_WRITE_TOKEN=

# --- Banco de fotos en la nube: la URL base que `banco-fotos.py subir` escribió en MI-MARCA.md (banco_url) ---
BANCO_URL=

# --- Rutas dentro del contenedor (déjalas así salvo que cambies los volúmenes del docker-compose.yml) ---
SKILL_DIR=/skill
PRIVADO_DIR=/privado
TRABAJO_DIR=/trabajo
# Dónde vive el banco de fotos. Por omisión PRIVADO_DIR/assets/fotos/reales; si esa carpeta no es escribible
# (privado/ va montado de solo lectura) y no trae catálogo, el entrypoint lo baja a TRABAJO_DIR/_banco.
# BANCO_DIR=/privado/assets/fotos/reales

# --- Ritmo del worker ---
WORKER_INTERVALO_S=15
SKILL_PULL_MIN=30
# BANCO_REFRESCO_H=24
# WORKER_HUERFANO_MIN=90
# TRABAJO_RETENCION_DIAS=7
# WORKER_TIMEOUT_VERSION_MIN=25
# ESCRIBIR_RONDAS=2
# WORKER_APPS_CONOCIDAS=CapCut,Claude,ChatGPT,WhatsApp,Canva,Excel,Notion,Instagram,TikTok,YouTube,Gemini

# --- Atender solo los pedidos de una marca (opcional; vacío = todas) ---
WORKSPACE_ID=

# --- Opcionales ---
# TZ=America/Mexico_City          zona horaria de los logs
# SKILL_RAMA=main                 rama de la skill que clona la imagen (para probar antes de mezclar a main)
